            <ImageButton android:id="@+id/play" android:layout_width="60dp" android:layout_height="60dp" android:background="@drawable/play_circle" android:src="@drawable/ic_classic_play" android:padding="18dp" android:contentDescription="Play" app:tint="#FFFFFF" />
            <ImageButton android:id="@+id/next" android:layout_width="0dp" android:layout_height="72dp" android:src="@drawable/ic_classic_next" android:background="?attr/selectableItemBackgroundBorderless" android:padding="24dp" android:contentDescription="Next track" android:layout_weight="1" app:tint="#1D9CFA" />
            <ImageButton android:id="@+id/queue" android:layout_width="0dp" android:layout_height="72dp" android:src="@drawable/ic_classic_queue" android:background="?attr/selectableItemBackgroundBorderless" android:padding="23dp" android:contentDescription="Play queue" android:layout_weight="1" app:tint="#1D9CFA" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="20dp" />
    </LinearLayout>
</FrameLayout>
