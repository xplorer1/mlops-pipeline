<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/libraryPanel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:id="@+id/homePanel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#1D9CFA">
                <LinearLayout android:layout_width="match_parent" android:layout_height="49dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="#1D9CFA">
                    <ImageButton android:id="@+id/homeMenu" android:layout_width="72dp" android:layout_height="48dp" android:src="@drawable/ic_classic_menu" android:background="?attr/selectableItemBackgroundBorderless" android:padding="20dp" android:contentDescription="Menu" app:tint="#FFFFFF" />
                    <TextView android:id="@+id/myTab" android:layout_width="34dp" android:layout_height="match_parent" android:text="MY" android:textSize="16sp" android:textColor="#FFFFFF" android:fontFamily="sans" android:gravity="center" />
                    <TextView android:id="@+id/discoveryTab" android:layout_width="94dp" android:layout_height="match_parent" android:text="DISCOVERY" android:textSize="16sp" android:textColor="#88D3FF" android:fontFamily="sans" android:gravity="center" />
                    <TextView android:id="@+id/recommendTab" android:layout_width="0dp" android:layout_height="match_parent" android:text="RECOMMEND" android:textSize="16sp" android:textColor="#88D3FF" android:fontFamily="sans" android:layout_weight="1" android:singleLine="true" android:gravity="center" />
                    <ImageButton android:id="@+id/search" android:layout_width="72dp" android:layout_height="48dp" android:src="@drawable/ic_classic_search" android:background="?attr/selectableItemBackgroundBorderless" android:padding="19dp" android:contentDescription="Search" app:tint="#FFFFFF" />
                </LinearLayout>
                <View android:layout_width="34dp" android:layout_height="3dp" android:layout_marginStart="72dp" android:background="#FFFFFF" />
                <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="184dp" android:gravity="bottom" android:padding="24dp" android:background="@drawable/home_background">
                            <ImageView android:layout_width="54dp" android:layout_height="54dp" android:padding="8dp" android:src="@drawable/ic_classic_person" android:background="@drawable/classic_avatar" android:importantForAccessibility="no" />
                            <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="vertical" android:paddingStart="24dp">
                                <TextView android:id="@+id/profileName" android:layout_width="wrap_content" android:layout_height="36dp" android:text="Local listener" android:textSize="20sp" android:textColor="#FFFFFF" android:gravity="center_vertical" android:fontFamily="sans" />
                                <TextView android:id="@+id/profileSubtitle" android:layout_width="wrap_content" android:layout_height="24dp" android:text="HiFi music" android:textSize="14sp" android:textColor="#80C1E8" android:gravity="center_vertical" android:fontFamily="sans" />
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="5dp" android:background="#FFFFFF">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                                <LinearLayout android:id="@+id/localMusic" android:layout_width="0dp" android:layout_weight="1" android:layout_height="73dp" android:layout_margin="5dp" android:gravity="center_vertical" android:background="#0086FF" android:padding="10dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:paddingEnd="5dp">
                                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_classic_music" android:importantForAccessibility="no" />
                                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="6dp">
                                        <TextView android:id="@+id/localMusicTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Local music" android:textSize="17sp" android:textColor="#FFFFFF" android:gravity="center_vertical" android:fontFamily="sans" android:maxLines="1" android:ellipsize="end" />
                                        <TextView android:id="@+id/localMusicCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 songs" android:textSize="13sp" android:textColor="#99D8FF" android:gravity="center_vertical" android:fontFamily="sans" />
                                    </LinearLayout>
                                </LinearLayout>
                                <LinearLayout android:id="@+id/audioDownloads" android:layout_width="0dp" android:layout_weight="1" android:layout_height="73dp" android:layout_margin="5dp" android:gravity="center_vertical" android:background="#3CA5F9" android:padding="10dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:paddingEnd="5dp">
                                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_classic_download" android:importantForAccessibility="no" />
                                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="6dp">
                                        <TextView android:id="@+id/audioDownloadsTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Audio download" android:textSize="16sp" android:textColor="#FFFFFF" android:gravity="center_vertical" android:fontFamily="sans" android:maxLines="1" android:ellipsize="end" />
                                        <TextView android:id="@+id/audioDownloadsCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Not connected" android:textSize="13sp" android:textColor="#99D8FF" android:gravity="center_vertical" android:fontFamily="sans" />
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                                <LinearLayout android:id="@+id/videoDownloads" android:layout_width="0dp" android:layout_weight="1" android:layout_height="73dp" android:layout_margin="5dp" android:gravity="center_vertical" android:background="#3CA5F9" android:padding="10dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:paddingEnd="5dp">
                                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_classic_download" android:importantForAccessibility="no" />
                                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="6dp">
                                        <TextView android:id="@+id/videoDownloadsTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MV download" android:textSize="16sp" android:textColor="#FFFFFF" android:gravity="center_vertical" android:fontFamily="sans" android:maxLines="1" android:ellipsize="end" />
                                        <TextView android:id="@+id/videoDownloadsCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Not connected" android:textSize="13sp" android:textColor="#99D8FF" android:gravity="center_vertical" android:fontFamily="sans" />
                                    </LinearLayout>
                                </LinearLayout>
                                <LinearLayout android:id="@+id/recentMusic" android:layout_width="0dp" android:layout_weight="1" android:layout_height="73dp" android:layout_margin="5dp" android:gravity="center_vertical" android:background="#1D9CFA" android:padding="10dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:paddingEnd="5dp">
                                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_classic_clock" android:importantForAccessibility="no" />
                                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="6dp">
                                        <TextView android:id="@+id/recentMusicTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Recent play" android:textSize="17sp" android:textColor="#FFFFFF" android:gravity="center_vertical" android:fontFamily="sans" android:maxLines="1" android:ellipsize="end" />
                                        <TextView android:id="@+id/recentMusicCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Current queue" android:textSize="13sp" android:textColor="#99D8FF" android:gravity="center_vertical" android:fontFamily="sans" />
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="180dp" android:orientation="vertical" android:padding="12dp" android:background="#F2F2F2">
                            <TextView android:id="@+id/favoriteHeading" android:layout_width="wrap_content" android:layout_height="40dp" android:text="My favorite" android:textSize="18sp" android:textColor="#454C50" android:gravity="center_vertical" android:fontFamily="sans" />
                            <LinearLayout android:layout_width="match_parent" android:layout_height="86dp" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/openFavorites" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                                <ImageView android:layout_width="86dp" android:layout_height="86dp" android:padding="28dp" android:background="#0086FF" android:src="@drawable/ic_classic_heart" android:importantForAccessibility="no" />
                                <TextView android:id="@+id/favoriteSongs" android:layout_width="0dp" android:layout_height="match_parent" android:text="Favorite songs" android:textSize="20sp" android:textColor="#454C50" android:gravity="center_vertical" android:fontFamily="sans" android:layout_weight="1" android:paddingStart="12dp" />
                                <TextView android:id="@+id/favoriteArrow" android:layout_width="28dp" android:layout_height="match_parent" android:text="›" android:textSize="28sp" android:textColor="#454C50" android:gravity="center_vertical" android:fontFamily="sans" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
            <LinearLayout android:id="@+id/localPanel" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FFFFFF">
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="#1D9CFA">
                    <ImageButton android:id="@+id/libraryBack" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_classic_back" android:background="?attr/selectableItemBackgroundBorderless" android:padding="13dp" android:contentDescription="Back to My music" app:tint="#FFFFFF" />
                    <TextView android:id="@+id/libraryTitle" android:layout_width="0dp" android:layout_height="match_parent" android:text="Local music" android:textSize="20sp" android:textColor="#FFFFFF" android:gravity="center_vertical" android:fontFamily="sans" android:layout_weight="1" />
                    <ImageButton android:id="@+id/scan" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_classic_search" android:background="?attr/selectableItemBackgroundBorderless" android:padding="13dp" android:contentDescription="Search local music" app:tint="#FFFFFF" />
                    <ImageButton android:id="@+id/addAudio" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_classic_more" android:background="?attr/selectableItemBackgroundBorderless" android:padding="13dp" android:contentDescription="Choose files" app:tint="#FFFFFF" />
                </LinearLayout>
                <LinearLayout android:id="@+id/libraryTip" android:layout_width="match_parent" android:layout_height="38dp" android:padding="4dp" android:background="#FFFFFF">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="Import lyrics once. Listen offline." android:textSize="14sp" android:textColor="#FFFFFF" android:paddingStart="8dp" android:gravity="center_vertical" android:background="#1D9CFA" />
                    <TextView android:id="@+id/dismissTip" android:layout_width="40dp" android:layout_height="match_parent" android:background="#1D9CFA" android:text="×" android:textSize="24sp" android:textColor="#FFFFFF" android:gravity="center" android:contentDescription="Dismiss lyric tip" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="37dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="#F2F2F2">
                    <TextView android:id="@+id/allSongs" android:layout_width="0dp" android:layout_height="match_parent" android:text="ALL" android:textSize="16sp" android:textColor="#1D9CFA" android:fontFamily="sans" android:layout_weight="1" android:gravity="center" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/artists" android:layout_width="0dp" android:layout_height="match_parent" android:text="ARTIST" android:textSize="16sp" android:textColor="#333333" android:fontFamily="sans" android:layout_weight="1" android:gravity="center" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/albums" android:layout_width="0dp" android:layout_height="match_parent" android:text="ALBUM" android:textSize="16sp" android:textColor="#333333" android:fontFamily="sans" android:layout_weight="1" android:gravity="center" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/folders" android:layout_width="0dp" android:layout_height="match_parent" android:text="FOLDER" android:textSize="16sp" android:textColor="#333333" android:fontFamily="sans" android:layout_weight="1" android:gravity="center" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
                </LinearLayout>
                <View android:id="@+id/tabIndicator" android:layout_width="90dp" android:layout_height="3dp" android:background="#3CA5F9" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="80dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageButton android:id="@+id/randomPlay" android:layout_width="70dp" android:layout_height="64dp" android:src="@drawable/ic_classic_random" android:background="?attr/selectableItemBackgroundBorderless" android:padding="22dp" android:contentDescription="Random play" app:tint="#1D9CFA" />
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="28dp" android:text="Random Play" android:textSize="16sp" android:textColor="#454C50" />
                        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="24dp" android:text="Random play (0 songs)" android:textSize="12sp" android:textColor="#888888" android:gravity="center_vertical" android:fontFamily="sans" />
                    </LinearLayout>
                    <ImageButton android:id="@+id/libraryActions" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_classic_queue" android:background="?attr/selectableItemBackgroundBorderless" android:padding="13dp" android:contentDescription="Library actions" app:tint="#1D9CFA" />
                    <TextView android:id="@+id/manageLabel" android:layout_width="70dp" android:layout_height="48dp" android:gravity="center_vertical" android:text="manage" android:textSize="14sp" android:textColor="#1D9CFA" />
                </LinearLayout>
                <ListView android:id="@+id/songs" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="#EEEEEE" android:dividerHeight="1dp" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="#F5F9FA" android:elevation="2dp">
            <ImageView android:id="@+id/miniArt" android:layout_width="50dp" android:layout_height="50dp" android:src="@drawable/classic_disc" android:contentDescription="Open now playing" android:layout_marginStart="9dp" android:layout_marginEnd="12dp" />
            <LinearLayout android:id="@+id/miniInfo" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical">
                <TextView android:id="@+id/miniTitle" android:layout_width="wrap_content" android:layout_height="28dp" android:text="No song selected" android:textSize="16sp" android:textColor="#454C50" android:gravity="center_vertical" android:fontFamily="sans" android:singleLine="true" android:ellipsize="end" android:contentDescription="Open now playing" />
                <TextView android:id="@+id/miniHint" android:layout_width="wrap_content" android:layout_height="22dp" android:text="‹ ‹ ‹  Swipe to change  › › ›" android:textSize="13sp" android:textColor="#1D9CFA" android:gravity="center_vertical" android:fontFamily="sans" />
            </LinearLayout>
            <ImageButton android:id="@+id/miniPlay" android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/ic_classic_play" android:background="?attr/selectableItemBackgroundBorderless" android:padding="20dp" android:contentDescription="Play" app:tint="#1D9CFA" />
            <ImageButton android:id="@+id/miniQueue" android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/ic_classic_queue" android:background="?attr/selectableItemBackgroundBorderless" android:padding="19dp" android:contentDescription="Play queue" app:tint="#1D9CFA" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/playerPanel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/player_background" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageButton android:id="@+id/back" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_classic_back" android:background="?attr/selectableItemBackgroundBorderless" android:padding="14dp" android:contentDescription="Back to library" app:tint="#FFFFFF" android:translationY="4dp" />
            <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="match_parent" android:text="Choose a song" android:textSize="20sp" android:textColor="#FFFFFF" android:gravity="center_vertical" android:fontFamily="sans" android:layout_weight="1" android:singleLine="true" android:ellipsize="end" android:translationY="4dp" />
            <ImageButton android:id="@+id/playerMenu" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_classic_more" android:background="?attr/selectableItemBackgroundBorderless" android:padding="13dp" android:contentDescription="Player options" app:tint="#FFFFFF" android:translationY="4dp" />
        </LinearLayout>
        <TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="26dp" android:text="" android:textSize="16sp" android:textColor="#FFFFFF" android:gravity="center_vertical" android:fontFamily="sans" android:paddingStart="50dp" android:singleLine="true" android:ellipsize="end" android:translationY="-4dp" />
        <TextView android:id="@+id/playerError" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="#FFD2B5" android:gravity="center_vertical" android:fontFamily="sans" android:visibility="gone" android:padding="8dp" />
        <FrameLayout android:id="@+id/playerBody" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
