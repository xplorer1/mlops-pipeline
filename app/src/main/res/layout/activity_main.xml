            <org.ttpod.recreation.WaveformView android:id="@+id/waveform" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="24dp" android:visibility="gone" android:contentDescription="Audio waveform visualizer" tools:viewBindingIgnore="true" />
            <ScrollView android:id="@+id/lyricsScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
                <TextView android:id="@+id/lyrics" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No lyrics selected" android:textSize="18sp" android:textColor="#AAB5C0" android:fontFamily="sans" android:gravity="center" android:padding="20dp" android:lineSpacingExtra="14dp" />
            </ScrollView>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:orientation="horizontal" android:gravity="center">
            <ImageView android:id="@+id/artPage" android:layout_width="22dp" android:layout_height="match_parent" android:contentDescription="Artwork page" android:clickable="true" android:src="@drawable/classic_page_dot" android:scaleType="center" android:focusable="true" />
            <ImageView android:id="@+id/lyricPage" android:layout_width="22dp" android:layout_height="match_parent" android:contentDescription="Lyrics page" android:clickable="true" android:src="@drawable/classic_page_dot" android:scaleType="center" android:focusable="true" />
            <ImageView android:id="@+id/detailsPage" android:layout_width="22dp" android:layout_height="match_parent" android:contentDescription="Track information" android:clickable="true" android:src="@drawable/classic_page_dot" android:scaleType="center" android:focusable="true" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center">
            <ImageButton android:id="@+id/importLyrics" android:layout_width="82dp" android:layout_height="40dp" android:src="@drawable/ic_classic_comment" android:background="?attr/selectableItemBackgroundBorderless" android:padding="9dp" android:contentDescription="Import lyrics" app:tint="#1D9CFA" />
            <ImageButton android:id="@+id/favorite" android:layout_width="82dp" android:layout_height="40dp" android:src="@drawable/ic_classic_heart" android:background="?attr/selectableItemBackgroundBorderless" android:padding="9dp" android:contentDescription="Add to favorites" app:tint="#1D9CFA" />
            <ImageButton android:id="@+id/share" android:layout_width="82dp" android:layout_height="40dp" android:src="@drawable/ic_classic_share" android:background="?attr/selectableItemBackgroundBorderless" android:padding="9dp" android:contentDescription="Share audio" app:tint="#1D9CFA" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:id="@+id/delayPanel" android:visibility="gone" android:gravity="center">
            <TextView android:id="@+id/earlier" android:layout_width="64dp" android:layout_height="match_parent" android:text="−0.5s" android:textSize="13sp" android:textColor="#FFFFFF" android:fontFamily="sans" android:gravity="center" android:clickable="true" android:focusable="true" android:contentDescription="Show lyrics half a second earlier" />
            <TextView android:id="@+id/delayLabel" android:layout_width="120dp" android:layout_height="match_parent" android:text="Delay 0.0s" android:textSize="13sp" android:textColor="#FFFFFF" android:fontFamily="sans" android:gravity="center" />
            <TextView android:id="@+id/later" android:layout_width="64dp" android:layout_height="match_parent" android:text="+0.5s" android:textSize="13sp" android:textColor="#FFFFFF" android:fontFamily="sans" android:gravity="center" android:clickable="true" android:focusable="true" android:contentDescription="Show lyrics half a second later" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
